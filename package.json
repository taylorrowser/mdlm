{
  "name": "mdlm",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "bin": {
    "mdlm": "./dist/mdlm.js",
    "req": "./dist/req-entry.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prototype": "npm run build --silent && node dist/prototype.js",
    "pretest": "npm run build --silent && node scripts/verify-test-suites.mjs",
    "test": "vitest run --config vitest.fast.config.ts && node --test scripts/frontier-loop-tests.mjs",
    "test:journeys": "npm run build --silent && node scripts/verify-test-suites.mjs && vitest run --config vitest.journeys.config.ts",
    "test:all": "npm test && npm run test:journeys",
    "test:watch": "vitest --config vitest.fast.config.ts",
    "typecheck": "tsc --noEmit",
    "frontier:start": "node scripts/frontier-loop.mjs start",
    "frontier:reload": "node scripts/frontier-loop.mjs reload",
    "frontier:status": "node scripts/frontier-loop.mjs status",
    "frontier:watch": "node scripts/frontier-loop.mjs watch",
    "frontier:health": "node scripts/frontier-loop.mjs health",
    "frontier:attach": "node scripts/frontier-loop.mjs attach",
    "frontier:stop": "node scripts/frontier-loop.mjs stop"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  }
}
