{
  "name": "mdlm",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "allowScripts": {
    "@google/genai": false,
    "fsevents": false,
    "protobufjs": false
  },
  "bin": {
    "mdlm": "./dist/mdlm.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "build:mdlm-pi": "npm run build --workspace=mdlm-pi",
    "test": "node scripts/run-bounded-tests.mjs --gate=pr",
    "test:pr": "npm test",
    "test:release": "node scripts/run-bounded-tests.mjs --gate=release",
    "test:mdlm-pi": "npm test --workspace=mdlm-pi",
    "test:all": "npm run test:release",
    "test:watch": "vitest --config vitest.fast.config.ts",
    "typecheck": "tsc --noEmit",
    "typecheck:mdlm-pi": "npm run typecheck --workspace=mdlm-pi",
    "frontier:start": "node scripts/frontier-loop.mjs start",
    "frontier:reload": "node scripts/frontier-loop.mjs reload",
    "frontier:status": "node scripts/frontier-loop.mjs status",
    "frontier:watch": "node scripts/frontier-loop.mjs watch",
    "frontier:health": "node scripts/frontier-loop.mjs health",
    "frontier:attach": "node scripts/frontier-loop.mjs attach",
    "frontier:stop": "node scripts/frontier-loop.mjs stop"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  }
}
