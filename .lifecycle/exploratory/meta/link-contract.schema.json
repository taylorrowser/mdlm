{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mdlm.dev/meta/v3/link-contract.schema.json",
  "title": "MDLM source-owned outgoing link contract",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "description", "targets", "cardinality", "freeze_resolution", "inverse_label"],
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
    "description": {"type": "string", "minLength": 1},
    "targets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "identity"],
        "properties": {
          "kind": {"enum": ["datum", "obligation-instance"]},
          "types": {"type": "array", "items": {"type": "string", "pattern": "^[A-Z]{3,8}$"}, "minItems": 1, "uniqueItems": true},
          "identity": {"enum": ["stable", "revision", "either", "exact-obligation-instance"]}
        },
        "allOf": [
          {"if": {"properties": {"kind": {"const": "datum"}}}, "then": {"required": ["types"]}}
        ]
      }
    },
    "cardinality": {
      "type": "object",
      "additionalProperties": false,
      "required": ["minimum", "maximum"],
      "properties": {
        "minimum": {"type": "integer", "minimum": 0},
        "maximum": {"oneOf": [{"type": "integer", "minimum": 1}, {"const": "many"}]}
      }
    },
    "freeze_resolution": {"enum": ["exact-revision", "already-exact", "not-applicable"]},
    "inverse_label": {"type": "string", "minLength": 1}
  }
}
