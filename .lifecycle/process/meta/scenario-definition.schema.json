{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mdlm.dev/meta/v3/scenario-definition.schema.json",
  "title": "MDLM scenario definition",
  "type": "object",
  "additionalProperties": false,
  "required": ["kind", "id", "version", "description", "phases", "inputs", "outputs", "prompt_ref", "review_policy_ref", "completion", "resolves", "prohibited_inputs", "batching"],
  "properties": {
    "kind": {"const": "scenario-definition"},
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
    "version": {"type": "integer", "minimum": 1},
    "description": {"type": "string", "minLength": 1},
    "initiation": {"const": "explicit"},
    "kernel_materialization": {"$ref": "#/$defs/kernelMaterialization"},
    "phases": {"type": "array", "items": {"type": "string", "pattern": "^phase-[0-9]+-[a-z0-9-]+$"}, "minItems": 1, "uniqueItems": true},
    "inputs": {"type": "array", "items": {"$ref": "#/$defs/input"}},
    "outputs": {"type": "array", "items": {"$ref": "#/$defs/output"}, "minItems": 1},
    "prompt_ref": {"type": "string", "pattern": "^prompts/.+\\.md@[1-9][0-9]*$"},
    "skills": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["reference", "summary"],
        "properties": {
          "reference": {"type": "string", "pattern": "^skills/.+\\.md@[1-9][0-9]*$"},
          "summary": {"type": "string", "minLength": 1}
        }
      }
    },
    "input_summaries": {
      "type": "object",
      "propertyNames": {"pattern": "^[a-z][a-z0-9_]*$"},
      "additionalProperties": {"type": "string", "minLength": 1}
    },
    "completion_summary": {"type": "string", "minLength": 1},
    "review_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required_evidence", "allowed_findings", "summary_rule", "correction_authorities"],
      "properties": {
        "required_evidence": {"type": "array", "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"}, "uniqueItems": true},
        "allowed_findings": {"type": "array", "items": {"enum": ["scope", "traceability", "observability", "consistency", "evidence", "independence"]}, "minItems": 1, "uniqueItems": true},
        "summary_rule": {"type": "string", "minLength": 1},
        "correction_authorities": {"type": "array", "items": {"enum": ["author", "stakeholder", "package-evidence"]}, "minItems": 1, "uniqueItems": true}
      }
    },
    "review_policy_ref": {"type": "string", "pattern": "^[a-z][a-z0-9-]*@[1-9][0-9]*$"},
    "review_policy_arguments": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {"pattern": "^[a-z][a-z0-9_]*$"},
      "additionalProperties": {"$ref": "expression.schema.json"}
    },
    "participation": {"$ref": "#/$defs/participation"},
    "authority_evidence": {"$ref": "#/$defs/authorityEvidence"},
    "standing_delegation": {"$ref": "#/$defs/standingDelegation"},
    "completion": {"$ref": "expression.schema.json"},
    "resolves": {"type": "array", "items": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"}, "uniqueItems": true},
    "prohibited_inputs": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "batching": {"enum": ["single", "coherent-batch", "either"]}
  },
  "$defs": {
    "kernelMaterialization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "output", "subject_input", "support_input", "payload_fields", "title_prefix", "baseline_kind", "baseline_role", "baseline_group", "evidence_subject_types", "evidence_types"],
      "properties": {
        "kind": {"const": "exact-baseline@1"},
        "output": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
        "subject_input": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
        "support_input": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
        "payload_fields": {
          "type": "object",
          "additionalProperties": false,
          "required": ["title", "kind", "role", "scope", "group", "members", "evidence"],
          "properties": {
            "title": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
            "kind": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
            "role": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
            "scope": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
            "group": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
            "members": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
            "evidence": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"}
          }
        },
        "title_prefix": {"type": "string", "minLength": 1},
        "baseline_kind": {"type": "string", "minLength": 1},
        "baseline_role": {"type": "string", "minLength": 1},
        "baseline_group": {"type": "string", "minLength": 1},
        "evidence_subject_types": {"type": "array", "items": {"type": "string", "pattern": "^[A-Z]{3,8}$"}, "uniqueItems": true},
        "evidence_types": {"type": "array", "items": {"type": "string", "pattern": "^[A-Z]{3,8}$"}, "uniqueItems": true}
      }
    },
    "standingDelegation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["selector_ref", "target_input", "authority", "delegate"],
      "properties": {
        "selector_ref": {"type": "string", "pattern": "^[a-z][a-z0-9-]*@[1-9][0-9]*$"},
        "target_input": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
        "authority": {"type": "string", "minLength": 1},
        "delegate": {"type": "string", "minLength": 1}
      }
    },
    "authorityEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["output", "type"],
      "properties": {
        "output": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
        "type": {"type": "string", "pattern": "^[A-Z]{3,8}$"}
      }
    },
    "participation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["policy_ref", "arguments"],
      "properties": {
        "policy_ref": {"type": "string", "pattern": "^[a-z][a-z0-9-]*@[1-9][0-9]*$"},
        "arguments": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {"$ref": "expression.schema.json"}
        }
      }
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "types", "cardinality", "identity"],
      "properties": {
        "name": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
        "types": {"type": "array", "items": {"type": "string", "pattern": "^[A-Z]{3,8}$"}, "minItems": 1, "uniqueItems": true},
        "cardinality": {"enum": ["one", "one-or-more", "zero-or-one", "zero-or-more"]},
        "identity": {"enum": ["stable", "revision", "either"]},
        "conditions": {"$ref": "expression.schema.json"}
      }
    },
    "requiredLink": {
      "type": "object",
      "additionalProperties": false,
      "required": ["link", "target"],
      "properties": {
        "link": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
        "distribution": {"enum": ["each-output", "partition", "cover"]},
        "target": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "input": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
            "output": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
            "payload": {
              "type": "object",
              "additionalProperties": false,
              "required": ["output", "path"],
              "properties": {
                "output": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
                "path": {"type": "string", "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)*$"}
              }
            }
          },
          "oneOf": [
            {"required": ["input"]},
            {"required": ["output"]},
            {"required": ["payload"]}
          ]
        }
      }
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "types", "cardinality", "required_links"],
      "properties": {
        "name": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
        "handle": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
        "types": {"type": "array", "items": {"type": "string", "pattern": "^[A-Z]{3,8}$"}, "minItems": 1, "uniqueItems": true},
        "cardinality": {"enum": ["one", "one-or-more", "zero-or-one", "zero-or-more"]},
        "identity_from": {
          "type": "object",
          "additionalProperties": false,
          "required": ["input"],
          "properties": {"input": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"}}
        },
        "required_links": {"type": "array", "items": {"$ref": "#/$defs/requiredLink"}},
        "permitted_links": {"type": "array", "items": {"$ref": "#/$defs/requiredLink"}},
        "required_payload": {
          "type": "object",
          "propertyNames": {"pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)*$"},
          "additionalProperties": {"type": ["string", "number", "boolean", "null"]}
        }
      }
    }
  }
}
