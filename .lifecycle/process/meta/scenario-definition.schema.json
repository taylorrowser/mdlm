{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mdlm.dev/meta/v3/scenario-definition.schema.json",
  "title": "MDLM scenario definition",
  "type": "object",
  "additionalProperties": false,
  "required": ["kind", "id", "version", "description", "phases", "inputs", "outputs", "prompt_ref", "review_policy_ref", "completion", "resolves", "prohibited_inputs", "batching"],
  "properties": {
    "kind": {"const": "scenario-definition"},
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
    "version": {"type": "integer", "minimum": 1},
    "description": {"type": "string", "minLength": 1},
    "initiation": {"const": "explicit"},
    "phases": {"type": "array", "items": {"type": "string", "pattern": "^phase-[0-9]+-[a-z0-9-]+$"}, "minItems": 1, "uniqueItems": true},
    "inputs": {"type": "array", "items": {"$ref": "#/$defs/input"}},
    "outputs": {"type": "array", "items": {"$ref": "#/$defs/output"}, "minItems": 1},
    "prompt_ref": {"type": "string", "pattern": "^prompts/.+\\.md@[1-9][0-9]*$"},
    "review_policy_ref": {"type": "string", "pattern": "^[a-z][a-z0-9-]*@[1-9][0-9]*$"},
    "review_policy_arguments": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {"pattern": "^[a-z][a-z0-9_]*$"},
      "additionalProperties": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"}
    },
    "participation": {"$ref": "#/$defs/participation"},
    "authority_evidence": {"$ref": "#/$defs/authorityEvidence"},
    "standing_delegation": {"$ref": "#/$defs/standingDelegation"},
    "completion": {"$ref": "expression.schema.json"},
    "resolves": {"type": "array", "items": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"}, "uniqueItems": true},
    "prohibited_inputs": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "batching": {"enum": ["single", "coherent-batch", "either"]}
  },
  "$defs": {
    "standingDelegation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["selector_ref", "target_input", "authority", "delegate"],
      "properties": {
        "selector_ref": {"type": "string", "pattern": "^[a-z][a-z0-9-]*@[1-9][0-9]*$"},
        "target_input": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
        "authority": {"type": "string", "minLength": 1},
        "delegate": {"type": "string", "minLength": 1}
      }
    },
    "authorityEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["output", "type"],
      "properties": {
        "output": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
        "type": {"type": "string", "pattern": "^[A-Z]{3,8}$"}
      }
    },
    "participation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["policy_ref", "arguments"],
      "properties": {
        "policy_ref": {"type": "string", "pattern": "^[a-z][a-z0-9-]*@[1-9][0-9]*$"},
        "arguments": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {"$ref": "expression.schema.json"}
        }
      }
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "types", "cardinality", "identity"],
      "properties": {
        "name": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
        "types": {"type": "array", "items": {"type": "string", "pattern": "^[A-Z]{3,8}$"}, "minItems": 1, "uniqueItems": true},
        "cardinality": {"enum": ["one", "one-or-more", "zero-or-one", "zero-or-more"]},
        "identity": {"enum": ["stable", "revision", "either"]},
        "conditions": {"$ref": "expression.schema.json"}
      }
    },
    "requiredLink": {
      "type": "object",
      "additionalProperties": false,
      "required": ["link", "target"],
      "properties": {
        "link": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
        "target": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "input": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
            "output": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
            "payload": {
              "type": "object",
              "additionalProperties": false,
              "required": ["output", "path"],
              "properties": {
                "output": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
                "path": {"type": "string", "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)*$"}
              }
            }
          },
          "oneOf": [
            {"required": ["input"]},
            {"required": ["output"]},
            {"required": ["payload"]}
          ]
        }
      }
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "types", "cardinality", "required_links"],
      "properties": {
        "name": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
        "types": {"type": "array", "items": {"type": "string", "pattern": "^[A-Z]{3,8}$"}, "minItems": 1, "uniqueItems": true},
        "cardinality": {"enum": ["one", "one-or-more", "zero-or-one", "zero-or-more"]},
        "required_links": {"type": "array", "items": {"$ref": "#/$defs/requiredLink"}}
      }
    }
  }
}
