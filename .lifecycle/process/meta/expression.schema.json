{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mdlm.dev/meta/v2/expression.schema.json",
  "title": "MDLM deterministic expression",
  "$ref": "#/$defs/expression",
  "$defs": {
    "arguments": {
      "type": "object",
      "additionalProperties": {
        "oneOf": [
          {"type": "string", "minLength": 1},
          {"$ref": "#/$defs/value"}
        ]
      }
    },
    "selectorInvocation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["selector", "arguments"],
      "properties": {
        "selector": {"type": "string", "pattern": "^[a-z][a-z0-9-]*@[1-9][0-9]*$"},
        "arguments": {"$ref": "#/$defs/arguments"}
      }
    },
    "value": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["literal"],
          "properties": {"literal": {}}
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["var"],
          "properties": {"var": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"}}
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["path"],
          "properties": {
            "path": {
              "type": "object",
              "additionalProperties": false,
              "required": ["var", "field"],
              "properties": {
                "var": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
                "field": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]*$"}
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["state"],
          "properties": {
            "state": {
              "type": "object",
              "additionalProperties": false,
              "required": ["dimension", "subject"],
              "properties": {
                "dimension": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
                "subject": {"$ref": "#/$defs/value"}
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["policy"],
          "properties": {
            "policy": {
              "type": "object",
              "additionalProperties": false,
              "required": ["ref", "arguments", "field"],
              "properties": {
                "ref": {"type": "string", "pattern": "^[a-z][a-z0-9-]*@[1-9][0-9]*$"},
                "arguments": {"$ref": "#/$defs/arguments"},
                "field": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]*$"}
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["count"],
          "properties": {"count": {"$ref": "#/$defs/selectorInvocation"}}
        }
      ]
    },
    "expression": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["compare"],
          "properties": {
            "compare": {
              "type": "object",
              "additionalProperties": false,
              "required": ["left", "operator", "right"],
              "properties": {
                "left": {"$ref": "#/$defs/value"},
                "operator": {"enum": ["eq", "ne", "in", "not-in", "gt", "gte", "lt", "lte", "contains", "matches"]},
                "right": {"$ref": "#/$defs/value"}
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["all"],
          "properties": {"all": {"type": "array", "items": {"$ref": "#/$defs/expression"}, "minItems": 1}}
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["any"],
          "properties": {"any": {"type": "array", "items": {"$ref": "#/$defs/expression"}, "minItems": 1}}
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["not"],
          "properties": {"not": {"$ref": "#/$defs/expression"}}
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["exists"],
          "properties": {"exists": {"$ref": "#/$defs/selectorInvocation"}}
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["none"],
          "properties": {"none": {"$ref": "#/$defs/selectorInvocation"}}
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["every"],
          "properties": {
            "every": {
              "type": "object",
              "additionalProperties": false,
              "required": ["selector", "arguments", "as", "satisfies"],
              "properties": {
                "selector": {"type": "string", "pattern": "^[a-z][a-z0-9-]*@[1-9][0-9]*$"},
                "arguments": {"$ref": "#/$defs/arguments"},
                "as": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
                "satisfies": {"$ref": "#/$defs/expression"}
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["present"],
          "properties": {"present": {"$ref": "#/$defs/value"}}
        }
      ]
    }
  }
}
