{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mdlm.dev/meta/v3/manifest.schema.json",
  "title": "MDLM process package manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["kind", "id", "version", "status", "description", "kernel_contract", "artifact_format", "references", "language", "compatibility", "catalog", "assets", "profiles", "provenance"],
  "properties": {
    "kind": {"const": "process-package-manifest"},
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "status": {"enum": ["experimental", "supported", "deprecated"]},
    "description": {"type": "string", "minLength": 1},
    "kernel_contract": {"type": "object"},
    "artifact_format": {"type": "object"},
    "references": {"type": "object"},
    "kernel_capabilities": {
      "type": "object",
      "propertyNames": {"pattern": "^[a-z][a-z0-9-]*@[1-9][0-9]*$"},
      "additionalProperties": {"$ref": "capability-binding.schema.json"}
    },
    "language": {
      "type": "object",
      "additionalProperties": false,
      "required": ["expressions"],
      "properties": {
        "expressions": {"const": "mdlm-expression@1"}
      }
    },
    "compatibility": {
      "type": "object",
      "properties": {
        "repository_migration": {"enum": ["compatible", "fresh-only"]}
      }
    },
    "catalog": {"type": "object"},
    "assets": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "uniqueItems": true,
        "items": {
          "type": "string",
          "pattern": "^(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._-]+(?:/[A-Za-z0-9._-]+)*\\.(?:md|yaml)@[1-9][0-9]*$"
        }
      }
    },
    "profiles": {"type": "object"},
    "provenance": {"type": "object"}
  }
}
