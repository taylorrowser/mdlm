{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mdlm.dev/meta/v2/template-definition.schema.json",
  "title": "MDLM type template definition",
  "type": "object",
  "additionalProperties": false,
  "required": ["kind", "id", "version", "description", "payload_schema", "outgoing_links"],
  "properties": {
    "kind": {"const": "type-template-definition"},
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
    "version": {"type": "integer", "minimum": 1},
    "description": {"type": "string", "minLength": 1},
    "extends": {"type": "string", "pattern": "^[a-z][a-z0-9-]*@[1-9][0-9]*$"},
    "payload_schema": {
      "type": "object",
      "required": ["$schema", "type", "properties"],
      "properties": {
        "$schema": {"const": "https://json-schema.org/draft/2020-12/schema"},
        "type": {"const": "object"},
        "required": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "properties": {"type": "object"}
      }
    },
    "outgoing_links": {"type": "array", "items": {"$ref": "link-contract.schema.json"}, "uniqueItems": true}
  }
}
