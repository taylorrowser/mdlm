{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mdlm.dev/meta/v2/policy-definition.schema.json",
  "title": "MDLM machine-readable policy definition",
  "type": "object",
  "additionalProperties": false,
  "required": ["kind", "id", "version", "description", "parameters", "result_schema", "default", "rules"],
  "properties": {
    "kind": {"const": "policy-definition"},
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
    "version": {"type": "integer", "minimum": 1},
    "description": {"type": "string", "minLength": 1},
    "parameters": {"type": "array", "items": {"$ref": "parameter.schema.json"}, "minItems": 1, "uniqueItems": true},
    "result_schema": {
      "type": "object",
      "required": ["$schema", "type", "properties"],
      "properties": {
        "$schema": {"const": "https://json-schema.org/draft/2020-12/schema"},
        "type": {"const": "object"},
        "properties": {"type": "object"}
      }
    },
    "default": {"type": "object"},
    "rules": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["priority", "when", "result"],
        "properties": {
          "priority": {"type": "integer"},
          "when": {
            "oneOf": [
              {"type": "string", "minLength": 1},
              {"$ref": "expression.schema.json"}
            ]
          },
          "result": {"type": "object"}
        }
      }
    }
  }
}
