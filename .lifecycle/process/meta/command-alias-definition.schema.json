{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mdlm.dev/meta/v2/command-alias-definition.schema.json",
  "title": "MDLM Package Command Alias definition",
  "type": "object",
  "additionalProperties": false,
  "required": ["kind", "id", "version", "description", "scenario", "arguments", "inputs"],
  "properties": {
    "kind": {"const": "command-alias-definition"},
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]*(\\.[a-z][a-z0-9-]*)+$"},
    "version": {"type": "integer", "minimum": 1},
    "description": {"type": "string", "minLength": 1},
    "scenario": {"type": "string", "pattern": "^[a-z][a-z0-9-]*@[1-9][0-9]*$"},
    "arguments": {
      "type": "object",
      "propertyNames": {"pattern": "^[a-z][a-z0-9_]*$"},
      "additionalProperties": {"$ref": "#/$defs/argument"}
    },
    "inputs": {
      "type": "object",
      "propertyNames": {"pattern": "^[a-z][a-z0-9_]*$"},
      "additionalProperties": {"$ref": "expression.schema.json"}
    }
  },
  "$defs": {
    "argument": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cardinality"],
      "properties": {
        "cardinality": {"enum": ["one", "one-or-more", "zero-or-one", "zero-or-more"]}
      }
    }
  }
}
