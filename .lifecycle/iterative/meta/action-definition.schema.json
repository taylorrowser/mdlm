{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mdlm.dev/meta/v3/action-definition.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "id",
    "version",
    "capability",
    "prompt_ref",
    "types"
  ],
  "properties": {
    "kind": {
      "const": "action-definition"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "description": {
      "type": "string"
    },
    "capability": {
      "enum": [
        "acceptance",
        "change",
        "experiment",
        "feedback",
        "implementation",
        "observation",
        "prototype",
        "requirements",
        "review",
        "verification-result",
        "independent-result",
        "verification-activity"
      ]
    },
    "prompt_ref": {
      "type": "string"
    },
    "types": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "subjects": {
      "type": "string"
    },
    "inputs": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "when": {
      "type": "string"
    },
    "priority": {
      "type": "integer"
    },
    "optional": {
      "type": "boolean"
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "name"
      ],
      "properties": {
        "kind": {
          "enum": [
            "independent-review",
            "stakeholder"
          ]
        },
        "name": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "links": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": {
          "type": "string"
        }
      }
    },
    "revises": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "fixed_payload": {
      "type": "object",
      "additionalProperties": {
        "type": "object"
      }
    }
  }
}
